# Copier en .env pour le développement local (jamais commité).
# Rôle applicatif à privilèges limités — voir backend/db/init/01-app-role.sql
# (la RLS ne s'applique jamais à un superutilisateur PostgreSQL).
DATABASE_URL=postgresql+asyncpg://restauhub_app:restauhub_app@localhost:5432/restauhub
# Rôle superutilisateur, réservé aux migrations Alembic (DDL).
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://restauhub:restauhub@localhost:5432/restauhub
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-every-environment-min-32-bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
TWO_FACTOR_ENCRYPTION_KEY=change-me-fernet-key-44-bytes-base64==
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
